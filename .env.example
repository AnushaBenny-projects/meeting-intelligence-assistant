APP_SENDER_NAME=Anusha
EMAIL_MODE=mock
EMAIL_FROM=assistant@example.com

# Optional LLM provider. Leave unset to use the deterministic local generator.
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4o-mini

# Real SMTP mode is optional. Never commit a populated .env file.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-username
SMTP_PASSWORD=replace-with-password
SMTP_USE_TLS=true
