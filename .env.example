APP_SENDER_NAME=Anusha
EMAIL_MODE=mock
EMAIL_FROM=assistant@example.com

# Optional LLM email drafting. Leave LLM_PROVIDER empty to use the deterministic local generator.
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Real SMTP mode is optional. Never commit a populated .env file.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-username
SMTP_PASSWORD=replace-with-password
SMTP_USE_TLS=true
